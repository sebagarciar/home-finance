# Copy to .env and fill in.

DATABASE_URL=sqlite:///./home_finance.db

# FX provider. exchangerate.host now requires a paid access key.
# If you don't have one, implement a different FxProvider (see app/services/fx/provider.py)
# and set FX_PROVIDER accordingly. Frankfurter does NOT cover CLP, so don't use it as primary.
FX_PROVIDER=exchangerate_host
FX_API_BASE=https://api.exchangerate.host
FX_API_KEY=

# Categorization
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=

# Email ingest: Santander ES transaction-notification emails over IMAP.
# Use a Gmail APP PASSWORD (Google Account -> Security -> App passwords),
# NOT your normal password. Fetch is read-only. Leave unset to disable.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
SANTANDER_EMAIL_SENDER=SantanderInforma@emailing.bancosantander-mail.es
# Which Account id the email rows post to (your Santander ES checking account):
SANTANDER_EMAIL_ACCOUNT_ID=1

# Basic-auth credentials for the app (single-user household setup)
APP_USERNAME=admin
APP_PASSWORD=change-me
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
